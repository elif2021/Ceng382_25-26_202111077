@page "{id:int}"
@model RazorPagesProject.Pages.Classes.DeleteModel

@{
    ViewData["Title"] = "Delete Class";
}

<h2>Delete Class</h2>

<div>
    <h4>Are you sure you want to delete this class?</h4>
    <div>
        <strong>Name:</strong> @Model.Class.Name
    </div>
    <div>
        <strong>Person Count:</strong> @Model.Class.PersonCount
    </div>
    <div>
        <strong>Description:</strong> @Model.Class.Description
    </div>
    <div>
        <strong>Is Active:</strong> @(Model.Class.IsActive ? "Yes" : "No")
    </div>

    <form method="post">
        <input type="hidden" asp-for="Class.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
