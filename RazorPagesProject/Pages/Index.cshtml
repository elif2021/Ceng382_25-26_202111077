@page
@model RazorPagesProject.Pages.IndexModel
@{
    ViewData["Title"] = "Class List";
}

<h1>Class List</h1>

<form method="get">
    <input type="text" name="FilterClassName" value="@Model.FilterClassName" placeholder="Filter by Class Name" />
    <button type="submit">Filter</button>
</form>

<table border="1" cellpadding="5">
    <thead>
        <tr>
            <th>Class Name</th>
            <th>Student Count</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.FilteredClassList)
        {
            <tr>
                <td>@item.ClassName</td>
                <td>@item.StudentCount</td>
                <td>@item.Description</td>
                <td>
                    <form method="post" asp-page-handler="Delete">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        if (i == Model.CurrentPage)
        {
            <strong>@i</strong>
        }
        else
        {
            <a asp-page="./Index" asp-route-CurrentPage="@i" asp-route-FilterClassName="@Model.FilterClassName">@i</a>
        }

        <text> </text>
    }
</div>
<h2>Add New Class</h2>

<form method="post" asp-page-handler="Add">
    <div>
        <label>Class Name:</label>
        <input type="text" name="FilteredClassList[0].ClassName" required />
    </div>
    <div>
        <label>Student Count:</label>
        <input type="number" name="FilteredClassList[0].StudentCount" required />
    </div>
    <div>
        <label>Description:</label>
        <input type="text" name="FilteredClassList[0].Description" required />
    </div>
    <button type="submit">Add Class</button>
</form>