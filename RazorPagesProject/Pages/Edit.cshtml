@page "{id:int}"
@model RazorPagesProject.Pages.EditModel
@{
    ViewData["Title"] = "Edit Class";
}

<h1>Edit Class</h1>

<form method="post">
    <div>
        <label>Class Name:</label>
        <input type="text" name="ClassName" value="@Model.ClassName" required />
    </div>
    <div>
        <label>Student Count:</label>
        <input type="number" name="StudentCount" value="@Model.StudentCount" required />
    </div>
    <div>
        <label>Description:</label>
        <input type="text" name="Description" value="@Model.Description" required />
    </div>
    <button type="submit">Save</button>
</form>